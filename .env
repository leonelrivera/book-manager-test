# Configuración de Entorno - Book Manager Sprint 2

# API de cotizaciones del dólar
API_URL=https://dolarapi.com/v1/dolares

# Conexión a Base de Datos (SQLAlchemy)
# Por defecto utiliza SQLite local, configurable a PostgreSQL / Supabase
DATABASE_URL=sqlite:///book_manager.db
# Para PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
